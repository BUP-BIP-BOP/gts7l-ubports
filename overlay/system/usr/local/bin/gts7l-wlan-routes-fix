#!/bin/sh
# NetworkManager takes the DHCP lease but frequently fails to install the
# connected and default routes on this Wi-Fi stack, which shows up as
# "connected, but no internet" — and also breaks plain LAN access.
#
# Adapted from the SM-T870 Droidian port, which hits the same defect on the
# same QCA6390 chip.
set -eu

for _ in $(seq 30); do
    for IF in wlan0 swlan0 wlp1s0; do
        CIDR=$(ip -4 -o addr show "$IF" 2>/dev/null | awk '/scope global/{print $4; exit}')
        [ -z "$CIDR" ] && continue

        GW=$(nmcli -t -f DHCP4.OPTION device show "$IF" 2>/dev/null \
             | grep -oE ':routers = [0-9.]+' | sed 's/.*= //' | head -1)
        NET=$(python3 -c 'import ipaddress,sys; print(ipaddress.ip_interface(sys.argv[1]).network)' "$CIDR" 2>/dev/null || true)

        [ -n "$NET" ] && ip route replace "$NET" dev "$IF" src "${CIDR%/*}" 2>/dev/null || true

        if [ -n "$GW" ]; then
            ip route replace default via "$GW" dev "$IF" onlink 2>/dev/null || true
            logger -t gts7l-wlan-routes "installed $NET and default via $GW on $IF"
            exit 0
        fi
    done
    sleep 3
done
exit 0
